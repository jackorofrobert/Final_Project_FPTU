# Copy to app/.env and fill in values.
# Env is loaded from app/.env via python-dotenv.

# Application
PORT=5000
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database (path relative to project root)
DATABASE_PATH=data/app.db

# Custom Mail API (replaces Gmail)
# Base URL of the mail-api container (port 8095)
MAIL_API_BASE_URL=http://localhost:8095
# App-level secret — value of X-Mail-Api-Token header
MAIL_API_TOKEN=your-mail-api-token-here

# ML Model (path relative to project root)
MODEL_PATH=models/model.joblib

# VirusTotal
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_DAILY_LIMIT=200

# Google AI Studio (Gemini) — translate to English
# Create an API key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional multiple keys (supports JSON array or comma-separated):
# GOOGLE_AI_API_KEYS=["key_1","key_2"]
# GOOGLE_AI_API_KEYS=key_1,key_2
GOOGLE_AI_API_KEYS=
GEMINI_TRANSLATION_MODEL=gemini-3-flash-preview
TRANSLATION_CHUNK_MAX_CHARS=4000
TRANSLATION_MAX_INPUT_CHARS=120000
TRANSLATION_CHUNK_DELAY_SECONDS=0.25

# Logging (optional)
LOG_LEVEL=INFO
# LOG_FILE=
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
